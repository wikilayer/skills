{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/chat-unread.sh\" start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/chat-unread.sh\" prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__get_chat_ticket",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/chat-unread.sh\" ticket"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/chat-unread.sh\" stop"
          }
        ]
      }
    ]
  }
}
